---
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import TrendStrip from '../components/TrendStrip.astro';
import emerging from '../data/emerging.json';
import {
  siteMeta, publishedEvents, allTrends, allForecasts, allSnapshots,
  total, fmtDate, statusLabel, forecastStatusLabel, trendById,
} from '../lib/data';
import { href } from '../lib/url';
import cluesData from '../data/clues.json';

const ranked = [...publishedEvents].sort((a, b) => total(b.scores) - total(a.scores));
// 首页门槛：与 scripts/export_astro.py 的 HOMEPAGE_MIN_TOTAL 保持一致（2026-11-16 由 50 提到 65）。
// 这个常量以前只在导出侧算 display.homepage，页面并没有用，所以首页照样混进 48 分的即时新闻。
const HOMEPAGE_MIN_TOTAL = 65;
const homepageEligible = publishedEvents.filter((e) => total(e.scores) >= HOMEPAGE_MIN_TOTAL);
const rankedEligible = ranked.filter((e) => total(e.scores) >= HOMEPAGE_MIN_TOTAL);
const lead = rankedEligible[0];
const rest = lead ? homepageEligible.filter((e) => e.id !== lead.id).slice(0, 6) : [];

const topTrends = [...allTrends].sort((a, b) => (b.evidenceCount ?? 0) - (a.evidenceCount ?? 0));
const maxEvidence = Math.max(1, ...allTrends.map((t) => t.evidenceCount ?? 0));
const openForecasts = allForecasts.filter((f) => f.status === 'open');
const latestSnap = allSnapshots[0];

const contents = [
  {
    head: '事件',
    items: rankedEligible.slice(0, 4).map((e) => ({ text: e.title, url: href(`/events/${e.id}/`) })),
  },
  {
    head: '趋势',
    items: topTrends.slice(0, 3).map((t) => ({ text: t.title, url: href(`/trends/${t.id}/`) })),
  },
  {
    head: '判断',
    items: openForecasts.slice(0, 3).map((f) => ({ text: f.claim, url: href('/forecasts/') })),
  },
];

const leadTotal = lead ? total(lead.scores) : 0;
---

<Base active="home">
  {!lead && (
    <section class="lead-empty">
      <div class="kicker">本期尚无通过发布校验的事件</div>
      <h1>还没有可以公开的记录。</h1>
      <p class="standfirst">
        content/ 里现有 {siteMeta.counts.pending} 条候选，全部处于待核实状态；公开构建不展示未通过发布校验的记录，也不用旧数据凑版面。
      </p>
    </section>
  )}
  {lead && (
  <section class="lead">
    <div class="lead-main">
      <div class="kicker">半年回溯 · 本期重点</div>
      <h1><a href={href(`/events/${lead.id}/`)}>{lead.title}</a></h1>
      <p class="standfirst">{lead.summary}</p>
      <div class="byline">
        {fmtDate(lead.date)} · 重要度 {leadTotal} · 可信度 {lead.credibility === 'high' ? '高' : lead.credibility === 'medium' ? '中' : '待核实'}
      </div>
    </div>
    <aside class="lead-side">
      {(lead.metrics ?? []).length > 0 ? (
        (lead.metrics ?? []).slice(0, 3).map((m: any) => (
          <div class="keyfig">
            <div class="label">{m.label}</div>
            <div class="value">{m.value}</div>
            {m.note && <div class="note">{m.note}</div>}
          </div>
        ))
      ) : (
        <>
          {lead.trends.length > 0 && (
            <div class="lead-side-block">
              <div class="label">归入趋势</div>
              {lead.trends.slice(0, 2).map((tr: any) => (
                <a class="lead-side-link" href={href(`/trends/${tr.id}/`)}>{trendById.get(tr.id)?.title ?? tr.id}</a>
              ))}
            </div>
          )}
          <div class="lead-side-block">
            <div class="label">证据</div>
            <div class="value" style="font-size:30px">{lead.sources.length}</div>
            <div class="note">个独立来源 · 可信度{lead.credibility === 'high' ? '高' : lead.credibility === 'medium' ? '中' : '待核实'}</div>
          </div>
          {lead.watch && (
            <div class="lead-side-block">
              <div class="label">下一步看什么</div>
              <div class="note" style="font-size:13px;line-height:1.7">{lead.watch}</div>
            </div>
          )}
        </>
      )}
    </aside>
  </section>
  )}

  <section style="border-top:1px solid var(--rule);padding:18px 0" aria-label="半年覆盖">
    <p class="count-line">已核实 {publishedEvents.length} 条事件 · {allTrends.length} 条趋势 · 历史事件均标明回溯研究</p>
    <div class="filters">{['05','06','07','08','09','10','11'].map((m) => <a class="chip" href={href(`/archive/#month-2026-${m}`)}>{Number(m)} 月 · {publishedEvents.filter((e) => e.date.startsWith(`2026-${m}`)).length}</a>)}</div>
    <p style="color:var(--ink-3);font-size:12px;line-height:1.8">回溯资料不等于当时预测；月份条数反映本轮研究覆盖，不用于判断领域是否突然爆发。</p>
  </section>

  <section class="contents" aria-label="本期要目">
    {contents.map((col) => (
      <ol>
        <li style="border-bottom:1px solid var(--rule-2);padding-bottom:6px;margin-bottom:2px">
          <span class="idx">要目</span>
          <span class="t" style="font-weight:600;letter-spacing:.12em;font-size:12px">{col.head}</span>
        </li>
        {col.items.map((it, i) => (
          <li>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <a href={it.url}><span class="t">{it.text}</span></a>
          </li>
        ))}
      </ol>
    ))}
  </section>

  <div class="section-head">
    <div>
      <span class="num">01 / 事件</span>
      <h2 style="margin-top:6px">最近发生的事</h2>
    </div>
    <a class="more" href={href('/events/')}>全部 {siteMeta.counts.events} 条 →</a>
  </div>
  <div class="event-list">
    {rest.map((e) => <EventRow event={e} />)}
  </div>

  <div class="section-head">
    <div>
      <span class="num">02 / 趋势</span>
      <h2 style="margin-top:6px">事件正在归并成什么</h2>
    </div>
    <a class="more" href={href('/trends/')}>趋势图谱 →</a>
  </div>
  <div class="trend-list">
    {topTrends.slice(0, 4).map((t, i) => (
      <div class="trend-item">
        <div class="trend-num">{String(i + 1).padStart(2, '0')}</div>
        <div>
          <a class="trend-title" href={href(`/trends/${t.id}/`)}>{t.title}</a>
          <p class="trend-thesis">{t.thesis}</p>
          <div class="conf">
            <span class={`status ${t.status}`}>{statusLabel[t.status]}</span>
            <span class="conf-bar"><i style={`width:${Math.round(((t.evidenceCount ?? 0) / maxEvidence) * 100)}%`}></i></span>
            <span class="v">证据 {t.evidenceCount ?? 0}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="section-head">
    <div>
      <span class="num">03 / 异军突起</span>
      <h2 style="margin-top:6px">谁在突然加速</h2>
    </div>
    <a class="more" href={href('/emerging/')}>异军突起 →</a>
  </div>
  <div class="em-brief">
    <div class="em-brief-head">
      <span class="em-brief-big">{emerging.domains.filter((d) => d.state === 'accelerating' || d.state === 'emerging_candidate').length}</span>
      <span class="em-brief-note">
        个领域达到加速门槛 · 其余 {emerging.domains.length} 个观察积累中，样本不足不排行
      </span>
    </div>
    {emerging.domains.length === 0
      ? topTrends.slice(0, 3).map((t) => (
          <a class="em-brief-row" href={href(`/trends/${t.id}/`)}>
            <span class="em-brief-name">{t.title}</span>
            <span class="em-brief-line">观察中 · 证据 {t.evidenceCount ?? 0} 条</span>
            <span class="em-brief-val">{t.evidenceCount ?? 0}</span>
          </a>
        ))
      : emerging.domains
          .slice()
          .sort((a, b) => b.recent.events - a.recent.events)
          .slice(0, 3)
          .map((d) => (
            <a class="em-brief-row" href={href('/emerging/#' + d.id)}>
              <span class="em-brief-name">{trendById.get(d.id)?.title ?? d.title ?? '观察领域'}</span>
              <span class="em-brief-line">{d.reason}</span>
              <span class="em-brief-val">{d.recent.events}</span>
            </a>
          ))}
  </div>

  <div class="section-head">
    <div>
      <span class="num">04 / 判断</span>
      <h2 style="margin-top:6px">可以被证伪的预测</h2>
    </div>
    <a class="more" href={href('/forecasts/')}>判断追踪 →</a>
  </div>
  {allForecasts.length > 0 ? (
    <table class="ledger">
      <thead>
        <tr><th>判断</th><th>提出</th><th>到期</th><th>置信</th><th>状态</th></tr>
      </thead>
      <tbody>
        {allForecasts.map((f) => (
          <tr>
            <td>{f.claim}</td>
            <td class="num">{fmtDate(f.madeAt)}</td>
            <td class="num">{fmtDate(f.dueBy)}</td>
            <td class="num">{f.confidence}</td>
            <td>{forecastStatusLabel[f.status]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <>
      <table class="ledger">
        <thead>
          <tr><th>趋势层判断（待到期复核）</th><th>验证期限</th><th>状态</th></tr>
        </thead>
        <tbody>
          {topTrends.slice(0, 3).map((t) => (
            <tr>
              <td><a href={href(`/trends/${t.id}/`)}>{t.judgment || t.title}</a></td>
              <td class="num">{fmtDate(t.verifyBy)}</td>
              <td>{statusLabel[t.status]}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="count-line">尚无正式发布的概率预测；上表是趋势层的可证伪判断，到期复核，历史补录不会包装为当时预测。</p>
    </>
  )}

  <div class="section-head">
    <div>
      <span class="num">05 / 档案</span>
      <h2 style="margin-top:6px">最近一期</h2>
    </div>
    <a class="more" href={href('/archive/')}>历史档案 →</a>
  </div>
  {latestSnap ? (
    <a href={href('/archive/')} style="display:block;border-top:1px solid var(--rule);padding-top:16px">
      <div class="kicker">{latestSnap.title}</div>
      <p style="font-family:var(--serif);font-size:18px;line-height:1.8;max-width:52em;color:var(--ink-2);margin:0">
        {latestSnap.summary}
      </p>
      <div class="fc-meta" style="margin-top:12px">
        {latestSnap.eventIds.length} 条事件 · {fmtDate(latestSnap.date)}
      </div>
    </a>
  ) : (
    <div style="border-top:1px solid var(--rule);padding-top:16px">
      <div class="kicker">尚无快照 · 以下是最近三条</div>
      <div class="event-list" style="margin-top:14px">
        {ranked.slice(0, 3).map((e) => <EventRow event={e} />)}
      </div>
      <p class="count-line">快照从下一期开始记录。按月份浏览过去半年的已核实事件；回溯分析标明研究时间，不冒充当时判断。</p>
    </div>
  )}

  <p class="count-line" style="margin-top:20px">
    另有 {(cluesData as any[]).length} 条待核线索单独成区：<a href={href('/clues/')}>线索区 →</a>。它们不计入上面的已核实数量。
  </p>
</Base>
