---
import { total, trendById, effectLabel, categoryLabel, regionLabel, fmtDate } from '../lib/data';
import { href } from '../lib/url';

interface Props {
  event: any;
  showSummary?: boolean;
}

const { event, showSummary = true } = Astro.props;
const t = total(event.scores);
const [, m, d] = event.date.split('-');
const dims = [
  event.scores.structural, event.scores.scope, event.scores.signal,
  event.scores.delta, event.scores.timeliness, event.scores.crossDomain,
];
---

<article class="event-row">
  <div class="event-date">
    <b>{Number(m)}.{String(Number(d)).padStart(2, '0')}</b>
    {event.date.slice(0, 4)}
  </div>
  <div>
    <a class="event-title" href={href(`/events/${event.id}/`)}>{event.title}</a>
    {showSummary && <p class="event-summary">{event.summary}</p>}
    <div class="event-tags">
      <span class="tag">{regionLabel[event.region] ?? event.region}</span>
      <span class="tag">{categoryLabel[event.category] ?? event.category}</span>
      {event.backfill && <span class="tag retro" title="事件首发时间晚于本轮采集，属于事后回溯补录">回溯补录</span>}
      {event.trends.slice(0, 3).map((tr: any) => {
        const known = trendById.get(tr.id);
        // 趋势没单独成页时不放链接，避免点进 404
        return known ? (
          <a class={`tag effect-${tr.effect}`} href={href(`/trends/${tr.id}/`)}>
            {effectLabel[tr.effect]} · {known.title.split(/[，,]/)[0]}
          </a>
        ) : (
          <span class={`tag effect-${tr.effect}`} title="该趋势暂未单独成页">
            {effectLabel[tr.effect]} · {tr.id}
          </span>
        );
      })}
      {event.credibility !== 'high' && (
        <span class="tag">{event.credibility === 'medium' ? '单一来源' : '待核实'}</span>
      )}
    </div>
  </div>
  <div class="event-score">
    <div class="score-total">{t}</div>
    <div class="score-cap">重要度</div>
    <div class="score-bars" aria-hidden="true">
      {dims.map((v) => <i class={v >= 55 ? 'on' : ''} style={`height:${6 + Math.round(v * 0.12)}px`}></i>)}
    </div>
  </div>
</article>
