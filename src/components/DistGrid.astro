---
interface Point {
  id: string;
  title: string;
  score: number;
  credibility: 'high' | 'medium' | 'low';
  href: string;
  date: string;
}
interface Props {
  items: Point[];
}
const { items } = Astro.props;

const W = 720;
const H = 176;
const PADL = 44;
const PADR = 18;
const PADT = 22;
const PADB = 26;
const MIN = 60;
const MAX = 100;
const ROWS = [
  { key: 'high', label: '高' },
  { key: 'medium', label: '中' },
  { key: 'low', label: '低' },
] as const;
const rowH = (H - PADT - PADB) / (ROWS.length - 1);
const xOf = (s: number) => PADL + ((Math.max(MIN, Math.min(MAX, s)) - MIN) / (MAX - MIN)) * (W - PADL - PADR);
const yOf = (c: string) => {
  const i = ROWS.findIndex((r) => r.key === c);
  return PADT + (i < 0 ? ROWS.length - 1 : i) * rowH;
};
const ticks = [60, 70, 80, 90, 100];
---

<figure class="dist">
  <figcaption>
    <span class="dist-title">重要度 × 可信度分布</span>
    <span class="dist-meta">{items.length} 条 · 横轴为六维加权总分，纵轴为证据等级</span>
  </figcaption>

  {items.length === 0 ? (
    <p class="dist-empty">暂无数据。等研究管线产出第一批事件后，这里会显示分布。</p>
  ) : (
    <svg
      class="dist-svg"
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={`${items.length} 条事件的重要度与可信度分布`}
    >
      {ticks.map((t) => (
        <g>
          <line x1={xOf(t)} y1={PADT - 6} x2={xOf(t)} y2={H - PADB + 6} class="dist-grid" />
          <text x={xOf(t)} y={H - PADB + 22} text-anchor="middle" class="dist-axis">{t}</text>
        </g>
      ))}
      {ROWS.map((r) => (
        <g>
          <line x1={PADL - 6} y1={yOf(r.key)} x2={W - PADR} y2={yOf(r.key)} class="dist-grid" />
          <text x={PADL - 12} y={yOf(r.key) + 4} text-anchor="end" class="dist-axis">{r.label}</text>
        </g>
      ))}
      <text x={PADL - 12} y={PADT - 10} text-anchor="end" class="dist-axis dim">可信</text>
      {items.map((p) => (
        <a href={p.href} class="dist-pt" aria-label={`${p.title}，${p.score} 分`}>
          <circle cx={xOf(p.score)} cy={yOf(p.credibility)} r="5" class={`dist-dot g-${p.credibility}`}>
            <title>{`${p.title} · ${p.score} 分 · 可信度${ROWS.find((r) => r.key === p.credibility)?.label}`}</title>
          </circle>
        </a>
      ))}
    </svg>
  )}
  <p class="dist-note">
    横轴是重要度（六维加权，不是报道量），纵轴是证据等级（高 = 多源独立，中 = 单一官方，低 = 二手转述）。
    右上角才是「重要且站得住」的事件；左上角高分低可信的，只进待核实队列。
  </p>
</figure>
