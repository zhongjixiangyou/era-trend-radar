---
import { eventsForTrend, siteMeta, fmtDate, statusLabel } from '../lib/data';
import { href } from '../lib/url';

interface Props {
  trend: any;
}

const { trend } = Astro.props;
const events = eventsForTrend(trend.id);
const start = Date.parse(siteMeta.window.from + 'T00:00:00Z');
const end = Date.parse(siteMeta.window.to + 'T00:00:00Z');
const pct = (d: string) =>
  Math.max(0, Math.min(100, ((Date.parse(d + 'T00:00:00Z') - start) / (end - start)) * 100));
---

<div class="strip">
  <div class="strip-head">
    <a class="strip-title" href={href(`/trends/${trend.id}/`)}>{trend.title}</a>
    <span class={`status ${trend.status}`}>{statusLabel[trend.status]}</span>
    <span class="strip-conf mono">{trend.confidence}</span>
  </div>
  <div class="strip-track">
    {events.map((e) => {
      const rel = e.trends.find((t: any) => t.id === trend.id);
      return (
        <a
          class={`strip-dot effect-${rel?.effect ?? 'support'}`}
          style={`left:${pct(e.date).toFixed(2)}%`}
          href={href(`/events/${e.id}/`)}
          title={`${fmtDate(e.date)} · ${e.title}`}
        ></a>
      );
    })}
    <span class="strip-now" style={`left:${pct(siteMeta.window.to).toFixed(2)}%`}></span>
  </div>
</div>
